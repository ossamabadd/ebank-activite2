{
  "info": {
    "name": "EBank — Parts 1 & 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Customers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/customers?name=&page=0&size=20",
        "header": []
      }
    },
    {
      "name": "Create customer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/customers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"test@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Customer details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/customers/1",
        "header": []
      }
    },
    {
      "name": "Update customer",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/customers/3",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mohamed\",\n  \"email\": \"mohamed@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Accounts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts?customerId=1",
        "header": []
      }
    },
    {
      "name": "Account details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts/{{accountId}}",
        "header": []
      }
    },
    {
      "name": "Create account",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"type\": \"CURRENT_ACCOUNT\",\n  \"currency\": \"MAD\",\n  \"balance\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Credit account",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/credit",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-credit-{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Debit account",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/debit",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-debit-{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Operation history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/accounts/{{accountId}}/operations",
        "header": []
      }
    },
    {
      "name": "MCP tools",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/tools",
        "header": []
      }
    },
    {
      "name": "Chat",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chat",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Quels sont les comptes de Hassan ?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
